# ==============================================================
# Audient AI — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ==============================================================

# --------------------------------------------------------------
# DATABASE (Supabase PostgreSQL)
# Get this from: Supabase Dashboard → Settings → Database → URI
# --------------------------------------------------------------
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# --------------------------------------------------------------
# GROQ API (Cloud Whisper + LLM extraction)
# Get a free key at: https://console.groq.com
# Both transcription and LLM extraction use this key.
# GROQ_TRANSCRIBE_MODEL: whisper-large-v3 (best accuracy, recommended)
# GROQ_EXTRACT_MODEL:    llama-3.1-8b-instant (fast + accurate extraction)
# --------------------------------------------------------------
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_TRANSCRIBE_MODEL=whisper-large-v3
GROQ_EXTRACT_MODEL=llama-3.1-8b-instant
# Burst-friendly backoff when Groq returns 429 / transient errors (defaults are sane).
# GROQ_RETRY_MAX_ATTEMPTS=6
# GROQ_RETRY_BASE_DELAY=1.25
# GROQ_RETRY_MAX_DELAY=45

# --------------------------------------------------------------
# SPEECH-TO-TEXT (Whisper — local fallback, unused when GROQ_API_KEY is set)
# Options: base (fast) | small | medium | large-v3 (accurate)
# base ≈ 15–30s/chunk on CPU. large-v3 ≈ 2min/chunk on CPU.
# --------------------------------------------------------------
WHISPER_MODEL=base

# Optional: where to cache HF models (default: ~/.cache/huggingface)
# HF_HOME=/path/to/your/model/cache

# --------------------------------------------------------------
# SPEAKER DIARIZATION (Pyannote — two-person mode)
# 1. Create token at: https://huggingface.co/settings/tokens
# 2. Accept model at: https://huggingface.co/pyannote/speaker-diarization-3.1
# 3. Accept model at: https://huggingface.co/pyannote/segmentation-3.0
# --------------------------------------------------------------
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# --------------------------------------------------------------
# FFMPEG (Windows / TorchCodec)
# Install a shared FFmpeg build (DLLs next to ffmpeg.exe). If pyannote/torchaudio logs
# 'Could not load libtorchcodec...', set FFMPEG_BIN to that folder (e.g. C:\ffmpeg\bin).
# FFMPEG_BIN=C:\ffmpeg\bin
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# --------------------------------------------------------------
# MEDICAL EXTRACTION (Ollama — fully offline LLM)
# 1. Install Ollama: https://ollama.com/download
# 2. Pull the model: ollama pull phi3:mini
# 3. Ollama starts automatically on Windows after install.
#    To start manually: ollama serve
#
# Model options (all offline):
#   phi3:mini        — best balance of speed + quality (recommended)
#   llama3.2:1b      — fastest, lightest
#   gemma2:2b        — good alternative
# --------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_EXTRACT_MODEL=phi3:mini

# --------------------------------------------------------------
# AUTHENTICATION (JWT)
# JWT_SECRET_KEY: use a long random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# JWT_EXPIRY_DAYS: how many days before tokens expire (default 7)
# --------------------------------------------------------------
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_EXPIRY_DAYS=7

# --------------------------------------------------------------
# SERVER
# --------------------------------------------------------------
PORT=5000
FLASK_DEBUG=false
SECRET_KEY=change-me-in-production

# Optional: override ffmpeg path if not on system PATH
# FFMPEG_PATH=/usr/local/bin/ffmpeg

# --------------------------------------------------------------
# STALE SESSIONS (dashboard cleanup)
# Conversations stuck in status=processing are marked failed when:
#   - POST /complete ran but the worker never finished: after PROCESSING_STALE_MINUTES (default 20)
#   - Live recording never completed (/complete never called): after RECORDING_PROCESSING_MAX_AGE_HOURS
#     since created_at (default 168 = 7 days; minimum enforced 24)
# API process also runs reconcile on startup and every STALE_SESSION_RECONCILE_INTERVAL_SECONDS (default 300).
# With Celery Beat + REDIS_URL, reconcile_stale_processing_task runs every CELERY_BEAT_RECONCILE_SECONDS (default 300).
# PROCESSING_STALE_MINUTES=20
# RECORDING_PROCESSING_MAX_AGE_HOURS=168
# STALE_SESSION_RECONCILE_INTERVAL_SECONDS=300
# CELERY_BEAT_RECONCILE_SECONDS=300
