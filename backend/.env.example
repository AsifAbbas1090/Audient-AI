# ==============================================================
# Audient AI — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ==============================================================

# --------------------------------------------------------------
# DATABASE (Supabase PostgreSQL)
# Get this from: Supabase Dashboard → Settings → Database → URI
# --------------------------------------------------------------
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# --------------------------------------------------------------
# SPEECH-TO-TEXT (Whisper)
# Options: base (fast) | small | medium | large-v3 (accurate)
# base ≈ 15–30s/chunk on CPU. large-v3 ≈ 2min/chunk on CPU.
# --------------------------------------------------------------
WHISPER_MODEL=base

# Optional: where to cache HF models (default: ~/.cache/huggingface)
# HF_HOME=/path/to/your/model/cache

# --------------------------------------------------------------
# SPEAKER DIARIZATION (Pyannote — two-person mode)
# 1. Create token at: https://huggingface.co/settings/tokens
# 2. Accept model at: https://huggingface.co/pyannote/speaker-diarization-3.1
# 3. Accept model at: https://huggingface.co/pyannote/segmentation-3.0
# --------------------------------------------------------------
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# --------------------------------------------------------------
# MEDICAL EXTRACTION (Ollama — fully offline LLM)
# 1. Install Ollama: https://ollama.com/download
# 2. Pull the model: ollama pull phi3:mini
# 3. Ollama starts automatically on Windows after install.
#    To start manually: ollama serve
#
# Model options (all offline):
#   phi3:mini        — best balance of speed + quality (recommended)
#   llama3.2:1b      — fastest, lightest
#   gemma2:2b        — good alternative
# --------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_EXTRACT_MODEL=phi3:mini

# --------------------------------------------------------------
# SERVER
# --------------------------------------------------------------
PORT=5000
FLASK_DEBUG=false
SECRET_KEY=change-me-in-production

# Optional: override ffmpeg path if not on system PATH
# FFMPEG_PATH=/usr/local/bin/ffmpeg
