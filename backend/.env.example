# --- Offline-first config ---

# Two-person diarization: create token at hf.co/settings/tokens, then accept BOTH:
#   - pyannote/speaker-diarization-3.1
#   - pyannote/segmentation-3.0
# HF_TOKEN=hf_xxxx

# Whisper model: base (fast, ~15–30s) | small | medium | large-v3 (accurate but ~2 min on CPU)
WHISPER_MODEL=base

# Ollama for medical extraction (run: ollama run llama3.1)
# OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_EXTRACT_MODEL=llama3.1

PORT=5000
HF_TOKEN=hf_xxxx